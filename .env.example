# Firebase web config (public, from the Firebase console > Project settings)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only). Paste the service account JSON as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional, defaults live in lib/config.ts
SESSION_DAYS=5
FIRESTORE_LOCATION=europe-west2
